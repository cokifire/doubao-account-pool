  "taskPayload": {
    "protocol": "workspace_resource_generation_v2",
    "source": "src/lib/workspace-resource/generation-contract.ts",
    "summary": "画布资源生成任务（含视频）冻结后的入参信封，zod strict 校验",
    "fields": {
      "lifecycleProjection": "object（任务生命周期投影）",
      "protocol": "'workspace_resource_generation_v2'（字面量）",
      "resource": {
        "resourceId": "string 1..32",
        "workspacePath": "string 1..512",
        "mediaType": "'image' | 'audio' | 'video'",
        "schemaId": "string 1..96",
        "inputHash": "string，长度必须 64（重试源为 1..64）",
        "prompt": "string 1..100000 且 trim 后非空；视频必填",
        "modelKey": "string 1..191",
        "inputs": "Array<{ resourceId, contentVersion(int>0), workspacePath, role, position(int>=0) }>，position 唯一",
        "imageInputPositions": "number[]",
        "audioInputPositions": "number[]",
        "videoInputPositions": "number[]",
        "toolCallId": "string|null",
        "sourceTurnId": "string|null"
      },
      "imageModel": "string?",
      "videoModel": "string?",
      "musicModel": "string?",
      "voiceModel": "string?",
      "previewText": "string 1..20000?",
      "language": "string 1..32?",
      "durationSeconds": "int 1..600?（mediaType='video' 时必填）",
      "count": "1（字面量）",
      "generationOptions": "Record<string, string|number|boolean|null|array|object>"
    },
    "videoRules": [
      "mediaType='video' 时 prompt 不可为 null",
      "mediaType='video' 时 durationSeconds 必填（1..600）",
      "imageInputPositions / audioInputPositions / videoInputPositions 之间不可重叠，且必须命中 inputs 中已声明的 position"
    ]
  }
}
